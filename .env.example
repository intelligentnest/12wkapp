# Copy to .env.local for local development, and add the same values in Vercel → Project → Settings → Environment Variables.
# Both values are safe to expose to the browser: access is enforced by Row Level Security.
# NEVER add the Supabase service-role/secret key to this app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Public URL of the deployed app (used to build magic-link redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
